{
  "name": "@featurefountain/browser",
  "version": "0.1.0",
  "description": "Public browser component for FeatureFountain",
  "type": "module",
  "license": "MIT",
  "homepage": "https://featurefountain.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airshiplabs/featurefountain-sdks.git"
  },
  "bugs": {
    "url": "https://github.com/airshiplabs/featurefountain-sdks/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
