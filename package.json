{
  "name": "@featurefountain/browser",
  "version": "0.2.0",
  "description": "Public browser component for Feature Fountain",
  "homepage": "https://featurefountain.ai",
  "bugs": {
    "url": "https://github.com/airshiplabs/featurefountain-sdks/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airshiplabs/featurefountain-sdks.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "prepare": "node scripts/install-git-hooks.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:vectors": "node scripts/check-embed-vectors.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0"
}
