{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "pnpm-lock.yaml",
    "tests/fixtures/embed-protocol.json",
    "tests/fixtures/embed-protocol.json.sha256",
    "playwright-report/**",
    "test-results/**"
  ]
}
